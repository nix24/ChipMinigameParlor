{
  "name": "chipminigameparlor",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local --local",
    "dev:discord": "bun --env-file=.dev.vars src/scripts/dev-discord.ts",
    "bot:status": "bun --env-file=.dev.vars src/scripts/bot-control.ts status",
    "bot:prod": "bun --env-file=.dev.vars src/scripts/bot-control.ts prod",
    "bot:restart": "bun --env-file=.dev.vars src/scripts/bot-control.ts restart",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "types": "wrangler types",
    "build:activity": "rm -rf ./build/activity && bun build ./activity/index.html --outdir ./build/activity --minify --splitting",
    "typecheck": "tsc --noEmit && tsc -p activity/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "test": "bun run build:activity && vitest run && bun run test:dev-proxy",
    "test:dev-proxy": "bun test/dev-tunnel-proxy.check.ts",
    "test:activity": "bun run build:activity && bun test/coinflip-browser.check.mjs",
    "dev:test": "bun run build:activity && vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --env local --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env=\"\" --remote",
    "release:staging": "bun run check && bun run test && bun run db:migrate:staging && bun run deploy:staging",
    "commands:register": "bun src/scripts/register-commands.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "drizzle-orm": "0.45.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.1",
    "@oxlint/plugins": "1.80.0",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^5.8.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
