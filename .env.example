NODE_ENV=development
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
# Local Discord controls. The admin token must match the production Worker secret.
BOT_PRODUCTION_URL=https://your-production-worker.workers.dev
BOT_ADMIN_TOKEN=
# Optional: enables the /8ball command.
GEMINI_API_KEY=
